[submodule "oh-my-zsh"]
  path = oh-my-zsh
  url = https://github.com/ohmyzsh/ohmyzsh.git
[submodule "z-zsh"]
  path = z-zsh
  url = https://github.com/sjl/z-zsh.git
[submodule "homedir/.vim/bundle/Vundle.vim"]
	path = homedir/.vim/bundle/Vundle.vim
	url = https://github.com/VundleVim/Vundle.vim.git
[submodule "zsh-custom/plugins/pnpm"]
	path = zsh-custom/plugins/pnpm
	url = https://github.com/baliestridev/pnpm.plugin.zsh.git
[submodule "zsh-custom/vendor/omz-plugin-pnpm"]
	path = zsh-custom/vendor/omz-plugin-pnpm
	url = https://github.com/ntnyq/omz-plugin-pnpm.git
